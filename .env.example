# Copy to .env.local and fill in your values:
# cp .env.example .env.local

# Required - Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/arogyamandiram
MONGO_DB=arogyamandiram

# Optional - Dev server port for `npm run dev`
PORT=3000

# Required - NextAuth (use a long random string for NEXTAUTH_SECRET in production)
# If you change PORT above, update this URL to match.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-at-least-32-characters-long

# Platform tour version (increment to trigger tour updates for users)
# Note: Use only integer values for the tour version to ensure proper comparison in the code.
NEXT_PUBLIC_DASHBOARD_TOUR_VERSION=1

# Debug mode (set to true to enable debug logging in the application)
NEXT_PUBLIC_DEBUG_MODE=true

# Required - Encryption for sensitive user data
ENCRYPTION_KEY=your-32-byte-hex-string-for-aes256

# ── AI / OpenAI-compatible endpoint ──────────────────────────────────────────
# Base URL for the OpenAI-compatible API.
# Official OpenAI (default):
#   OPENAI_BASE_URL=https://api.openai.com/v1
# Azure OpenAI:
#   OPENAI_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
# Local (Ollama, LM Studio, llama-swap, etc.):
#   OPENAI_BASE_URL=http://localhost:11434/v1
# Third-party compatible (Together.ai, Anyscale, etc.):
#   OPENAI_BASE_URL=https://api.together.xyz/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# API key for your provider.
# For local endpoints that require no auth, set to any non-empty string (e.g. "local").
OPENAI_API_KEY=sk-...

# Optional - OpenAI organization ID (billing / org management — OpenAI only)
OPENAI_ORG_ID=

# Optional - Model overrides.
# Set to the model name your endpoint serves.
# Leave blank to use the built-in defaults (gpt-5.4 / gpt-5.4-mini).
# Examples: llama3.1, mistral-nemo, gpt-4o, unsloth/Qwen3.6-27B
OPENAI_MODEL_BEST=
OPENAI_MODEL_ORCHESTRATOR=

# Required - Food search (USDA FoodData Central — free, get key at https://fdc.nal.usda.gov/api-key-signup)
# Use DEMO_KEY for local testing (lower rate limit)
FDC_API_KEY=DEMO_KEY

# Optional - Food cache TTL in days (default: 7)
FOOD_CACHE_TTL_DAYS=7

# Email server hosts (users provide only email + app password in Preferences)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Required for email cron jobs - generate a long random secret (32+ chars)
# Used to authenticate Vercel Cron requests to /api/cron/* and internal email processing routes
CRON_SECRET=your-random-cron-secret-at-least-32-chars
