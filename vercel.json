{
  "framework": "nextjs",
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"feature/vercel-01\" ]; then exit 1; else exit 0; fi",
  "crons": [
    {
      "path": "/api/cron/send-reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/process-email-replies",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/generate-daily-plans",
      "schedule": "55 23 * * *"
    }
  ]
}
